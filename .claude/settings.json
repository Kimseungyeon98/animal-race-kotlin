{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/test-before-commit.sh",
            "timeout": 900,
            "statusMessage": "커밋 전 테스트 중…"
          }
        ]
      }
    ]
  }
}
